# usage-board configuration. Copy to .env and fill in.
# Every provider key is OPTIONAL: a card appears only for keys you set.

# --- Access -----------------------------------------------------------------
# Domain that points at this server (DNS A record → its public IP).
# Used by Caddy (default compose) to get a Let's Encrypt certificate.
DOMAIN=usage.example.com

# HTTP Basic Auth for the dashboard (UI + API). Set BOTH or NEITHER:
#  - both set    → every request requires these credentials
#  - both empty  → no auth (only safe on localhost / private networks)
# Setting exactly one = config error, the app refuses to start.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Read-only agent token for GET /api/limits only. Empty = route is public.
# Send it as: Authorization: Bearer <token> | X-Agent-Token | X-Api-Token.
AGENT_API_TOKEN=

# App-only mode (docker-compose.app-only.yml): host port for the app.
# APP_PORT=8080

# --- Polling / storage -------------------------------------------------------
USAGE_POLL_SECONDS=60
USAGE_WINDOW_HOURS=24
USAGE_QUOTA_PROBE_SECONDS=300

# --- Providers (all optional; empty key = card hidden) -----------------------
# DeepSeek (balance): https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# OpenRouter (credits / key usage / per-model): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Management key (optional, read-only): unlocks /api/v1/keys + per-model table
OPENROUTER_MANAGEMENT_KEY=

# Z.AI GLM Coding Plan (5h + weekly + MCP quotas)
ZAI_API_KEY=

# Command Code GOAT (monthly credits + 5h/weekly windows)
COMMANDCODE_API_KEY=

# Kimi Coding (weekly quota + 5h window)
KIMI_API_KEY=

# OpenCode Go (monthly remaining + 5h/weekly windows)
OPENCODE_GO_API_KEY=

# Cursor (plan total % + Cursor-model % + other-model %, read-only)
# Browser session token: DevTools → Application → Cookies → cursor.com →
# WorkosCursorSessionToken (format <userId>::<accessToken>), or the bare
# access token. Undocumented dashboard API; refresh the token when it expires.
CURSOR_SESSION_TOKEN=

# --- Page title (optional) ----------------------------------------------------
# Empty = «Мои подписки» / "My subscriptions".
SITE_TITLE=

# UI timestamps. Empty = UTC. Example: Europe/Moscow
DISPLAY_TZ=

# --- Egress (only if a provider API is blocked from your server) --------------
# HTTP CONNECT or SOCKS5/SOCKS5h proxy, per provider:
# OPENROUTER_PROXY=socks5h://user:pass@host:port
# ZAI_PROXY=
# COMMANDCODE_PROXY=
# KIMI_PROXY=
# OPENCODE_GO_PROXY=
# CURSOR_PROXY=
# Custom API origin (rarely needed, e.g. a compatible reverse proxy):
# OPENROUTER_BASE_URL=https://openrouter.ai
# OPENROUTER_SSL_NO_VERIFY=0
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# CURSOR_BASE_URL=https://api2.cursor.sh

# --- Compose-only vars (not read by the app) ----------------------------------
# On docker networks shared with other compose projects set a project name:
# COMPOSE_PROJECT_NAME=usage-board
